# Supabase project URL and publishable/anon key (safe to expose to the browser).
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Server-only Supabase service role key. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# This confirmed email receives the initial admin role.
OWNER_EMAIL="YOUR_ADMIN_EMAIL"

# Optional. Without a Gemini key, the server uses its limited local fallback.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional Google AdSense settings. Create an AdSense account and ad units first.
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_DASHBOARD_SLOT=""
VITE_ADSENSE_SPOTS_SLOT=""
